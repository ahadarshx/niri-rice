#!/usr/bin/env bash
# Drop-down terminal for niri: one floating Ghostty you show/hide with a key.
# It runs a tmux session called "drop": hiding detaches (the window closes, the
# session keeps running), showing reattaches. No hidden workspace needed.
app="com.ghostty.dropdown"

read -r id focused < <(niri msg --json windows | python3 -I -c '
import json, sys
for w in json.load(sys.stdin):
    if w.get("app_id") == sys.argv[1]:
        print(w["id"], int(bool(w.get("is_focused")))); break
else:
    print("none", 0)' "$app")

if [[ $id == none ]]; then
    exec ghostty --class="$app" --title="drop-down" \
        -e tmux new-session -A -s drop \; set-option -t drop status off
elif [[ $focused == 1 ]]; then
    tmux detach-client -s drop            # window closes, session lives on
else
    ws=$(niri msg --json workspaces | python3 -I -c '
import json, sys
print(next(w["idx"] for w in json.load(sys.stdin) if w.get("is_focused")))')
    niri msg action move-window-to-workspace --window-id "$id" --focus false "$ws"
    niri msg action focus-window --id "$id"
fi
