# colours follow the wallpaper (generated by DMS)
theme = dankcolors

background-opacity = 0.55
window-theme = ghostty


# I-beam cursor
cursor-style = bar

# Padding on every side
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true

# Nerd Font (Cascadia Code with Nerd Font glyphs)
font-family = "Cascadia Code NF"

# Cursor trail: a thin streak follows the cursor and fades, in the cursor colour
# (follows the wallpaper). Delete this line to turn it off.
custom-shader = shaders/cursor_trail.glsl
