# cava config generated by DMS / matugen from the wallpaper.
# Template: ~/.config/matugen/templates/cava.config
# cava - Catppuccin Mocha (mauve -> pink -> peach)

[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1
sleep_timer = 10

[output]
method = noncurses
orientation = bottom

[color]
# background stays the terminal's (#11111b in Ghostty)
gradient = 1
gradient_count = 3
gradient_color_1 = '{{colors.primary.default.hex}}'
gradient_color_2 = '{{colors.tertiary.default.hex}}'
gradient_color_3 = '{{colors.secondary.default.hex}}'

[smoothing]
noise_reduction = 77
monstercat = 1
